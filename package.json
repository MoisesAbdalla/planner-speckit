{
  "name": "planner-financeiro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project planner-rules-test \"vitest run --project rules\"",
    "test:all": "npm run test && npm run test:rules && npm run test:integration",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:integration": "firebase emulators:exec --only auth,firestore --project planner-rules-test \"vitest run --project integration\""
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "^15.28.2",
    "globals": "^16.5.0",
    "jsdom": "^28.0.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
